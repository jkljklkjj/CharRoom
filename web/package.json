{
  "name": "charroom-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "test:messages": "node scripts/generate-protocol-constants.cjs --check && node --experimental-vm-modules --test tests/message-contract.test.cjs",
    "generate:protocol": "node scripts/generate-protocol-constants.cjs",
    "generate:site": "node scripts/generate-static-site-files.cjs",
    "generate:icons": "node scripts/generate-favicons.cjs",
    "build": "node scripts/generate-favicons.cjs && node scripts/generate-static-site-files.cjs && node scripts/generate-protocol-constants.cjs && npm run typecheck && vite build && node scripts/inline-critical-css.cjs && node scripts/build-route-heads.cjs && node scripts/inline-shell.cjs",
    "build:seo": "npm run build && npm run prerender",
    "prerender": "node scripts/prerender.cjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "node scripts/generate-protocol-constants.cjs --check && node --experimental-vm-modules --test tests/*.test.cjs",
    "test:browser": "node tests/browser-smoke.cjs"
  },
  "dependencies": {
    "dompurify": "^3.0.5",
    "protobufjs": "^7.2.3",
    "vue": "^3.3.4",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/compiler-sfc": "^3.5.34",
    "fake-indexeddb": "^6.2.6",
    "png-to-ico": "^3.0.1",
    "puppeteer-core": "^20.8.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.3.13"
  }
}
